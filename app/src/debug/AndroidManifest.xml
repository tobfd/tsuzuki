<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug-only component catalog with its own launcher entry. -->
        <activity
            android:name=".catalog.CatalogActivity"
            android:exported="true"
            android:label="@string/catalog_launcher_label"
            android:theme="@style/Theme.Tsuzuki">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Debug-only: pins a widget for emulator checks (see PinWidgetActivity). -->
        <activity
            android:name=".catalog.PinWidgetActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Debug-only: sample session and data for widget checks (see WidgetSampleDataActivity). -->
        <activity
            android:name=".catalog.WidgetSampleDataActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
