<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug-only component catalog: no launcher entry, opened by tapping the version in
             Settings > About 7 times. Release builds don't contain it. -->
        <activity
            android:name=".catalog.CatalogActivity"
            android:exported="false"
            android:label="@string/catalog_launcher_label"
            android:theme="@style/Theme.Tsuzuki" />
        <!-- Debug-only: pins a widget for emulator checks (see PinWidgetActivity). -->
        <activity
            android:name=".catalog.PinWidgetActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Debug-only: sample session and data for widget checks (see WidgetSampleDataActivity). -->
        <activity
            android:name=".catalog.WidgetSampleDataActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
